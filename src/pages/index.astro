    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
      <!-- LEFT PANEL: Form + Cart + Payment (5/12) -->
      <section class="lg:col-span-5 flex flex-col gap-6">
        <div id="sales-mount"></div>
