                transition: all 0.18s ease;
            }
            .radio-item:hover {
                border-color: #c7c7d9;
                background: #f3f4f6;
            }
            .radio-item input {
                width: auto;
                margin: 0;
                accent-color: var(--biru);
            }
            .radio-item.checked {
                border-color: var(--biru);
                background: var(--biru-soft);
