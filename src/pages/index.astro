---
const GAS_API_URL =
    "https://script.google.com/macros/s/AKfycbx99wNr-G6O4imTqDjngEitpJjtqm4HZrnL_F1fEYJ6HmQLI09vHfUkGspg057obzPE4w/exec";
---

<!doctype html>
<html lang="id">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Input Penjualan Decant TELBA</title>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link
            rel="preconnect"
            href="https://fonts.gstatic.com"
            crossorigin
        />
        <link
            href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap"
            rel="stylesheet"
        />
        <style>
            :root {
                /* TELBA Brand Palette (Ref: telba.xyz) */
                --bg: #f7f5f1;
                --surface: #ffffff;
                --chocolate: #2a1b15;
                --chocolate-2: #3a271f;
                --cream: #f5ebd6;
                --cream-muted: #8a7e6e;
                --gold: #c19a4b;
                --gold-deep: #a07c34;
                --gold-soft: rgba(193, 154, 75, 0.08);
                --line: #e6e1d8;
                --text: #1f1612;
                --text-muted: #6b6259;
                --radius: 4px;
            }
            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }
            html, body {
                font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
                min-height: 100vh;
                background: var(--bg);
                color: var(--text);
                -webkit-font-smoothing: antialiased;
                -moz-osx-font-smoothing: grayscale;
            }

            /* Layout utama full-width ala dashboard modern */
            .layout {
                display: grid;
                grid-template-columns: 260px 1fr;
                min-height: 100vh;
            }

            /* Sidebar - identitas TELBA */
            .sidebar {
                background: var(--chocolate);
                color: var(--cream);
                padding: 40px 32px;
                display: flex;
                flex-direction: column;
                gap: 32px;
            }
            .sidebar-brand {
                font-family: "Cormorant Garamond", serif;
                font-size: 1.8rem;
                font-weight: 600;
                letter-spacing: 0.04em;
                color: var(--cream);
                display: flex;
                align-items: center;
                gap: 12px;
            }
            .sidebar-brand .dot {
                width: 8px; height: 8px;
                border-radius: 50%;
                background: var(--gold);
            }
            .sidebar-sub {
                font-size: 11px;
                letter-spacing: 0.25em;
                text-transform: uppercase;
                color: var(--gold);
                font-weight: 500;
            }
            .sidebar-nav {
                display: flex;
                flex-direction: column;
                gap: 6px;
                margin-top: 16px;
            }
            .nav-item {
                padding: 12px 16px;
                border-radius: var(--radius);
                color: rgba(245, 235, 214, 0.7);
                font-size: 14px;
                font-weight: 500;
                cursor: pointer;
                transition: all 0.15s ease;
                border-left: 2px solid transparent;
            }
            .nav-item:hover {
                color: var(--cream);
                background: rgba(212, 168, 87, 0.08);
            }
            .nav-item.active {
                color: var(--gold);
                background: rgba(212, 168, 87, 0.12);
                border-left-color: var(--gold);
            }

            /* Main content full-width */
            .main {
                padding: 48px 56px;
                width: 100%;
                max-width: 100%;
            }
            .page-head {
                display: flex;
                justify-content: space-between;
                align-items: flex-end;
                margin-bottom: 36px;
                padding-bottom: 24px;
                border-bottom: 1px solid var(--line);
            }
            .page-title {
                font-family: "Cormorant Garamond", serif;
                font-size: 2.4rem;
                font-weight: 600;
                letter-spacing: -0.01em;
                color: var(--chocolate);
                line-height: 1.1;
            }
            .page-title-sub {
                font-size: 12px;
                letter-spacing: 0.2em;
                text-transform: uppercase;
                color: var(--text-muted);
                font-weight: 500;
                margin-bottom: 8px;
            }

            /* Card form full-width clean */
            .card {
                background: var(--surface);
                border: 1px solid var(--line);
                border-radius: var(--radius);
                padding: 40px 44px;
                width: 100%;
            }
            .card-head {
                display: flex;
                align-items: center;
                justify-content: space-between;
                margin-bottom: 28px;
            }
            .card-title {
                font-family: "Cormorant Garamond", serif;
                font-size: 1.4rem;
                font-weight: 600;
                color: var(--chocolate);
            }
            .card-tag {
                font-size: 10px;
                letter-spacing: 0.2em;
                text-transform: uppercase;
                color: var(--text-muted);
                background: var(--bg);
                padding: 6px 12px;
                border-radius: 999px;
                font-weight: 600;
            }

            /* Form grid responsif full width */
            .form-grid {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 24px 28px;
            }
            .form-field {
                display: flex;
                flex-direction: column;
            }
            .form-field.full {
                grid-column: 1 / -1;
            }
                        textarea {
                width: 100%;
                padding: 14px 0;
                border: none;
                border-bottom: 1.5px solid var(--line);
                background: transparent;
                font-size: 16px;
                font-family: inherit;
                color: var(--text);
                transition: border-color 0.2s ease;
                border-radius: 0;
                resize: none;
                min-height: 45px;
                display: block;
            }
            textarea::placeholder {
                color: #b8aea0;
                font-weight: 400;
            }
            textarea:focus {
                outline: none;
                border-bottom-color: var(--gold);
            }
            label {
                font-size: 11px;
                letter-spacing: 0.18em;
                text-transform: uppercase;
                color: var(--text-muted);
                margin-bottom: 10px;
                font-weight: 600;
            }
            input,
            select {
                width: 100%;
                padding: 14px 0;
                border: none;
                border-bottom: 1.5px solid var(--line);
                background: transparent;
                font-size: 16px;
                font-family: inherit;
                color: var(--text);
                transition: border-color 0.2s ease;
                border-radius: 0;
            }
            input::placeholder {
                color: #b8aea0;
                font-weight: 400;
            }
            input:hover:not(:disabled),
            select:hover:not(:disabled) {
                border-bottom-color: var(--gold-deep);
            }
            input:focus,
            select:focus {
                outline: none;
                border-bottom-color: var(--gold);
            }
            input:disabled,
            select:disabled {
                color: #c4baab;
                cursor: not-allowed;
                border-bottom-style: dashed;
            }

            /* Toggle button (Volume) - clean minimal */
            .radio-group {
                display: grid;
                grid-template-columns: repeat(4, 1fr);
                gap: 8px;
            }
            .radio-item {
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 12px 8px;
                border: 1px solid var(--line);
                border-radius: var(--radius);
                cursor: pointer;
                font-size: 14px;
                font-weight: 500;
                color: var(--text-muted);
                background: var(--surface);
                transition: all 0.15s ease;
            }
            .radio-item:hover {
                border-color: var(--gold-deep);
                color: var(--text);
            }
            .radio-item input {
                display: none;
            }
            .radio-item.checked {
                border-color: var(--chocolate);
                background: var(--chocolate);
                color: var(--cream);
            }

            .input-prefix {
                position: relative;
            }
            .input-prefix input {
                padding-left: 32px;
                font-weight: 600;
            }
            .input-prefix::before {
                content: "Rp";
                position: absolute;
                left: 0;
                top: 50%;
                transform: translateY(-50%);
                color: var(--text-muted);
                font-size: 14px;
                font-weight: 500;
            }

            /* Submit - clean full-width */
            .form-actions {
                margin-top: 36px;
                padding-top: 28px;
                border-top: 1px solid var(--line);
                display: flex;
                justify-content: flex-end;
                align-items: center;
                gap: 16px;
            }
            button {
                background: var(--chocolate);
                color: var(--cream);
                border: none;
                padding: 16px 40px;
                font-size: 13px;
                letter-spacing: 0.2em;
                text-transform: uppercase;
                font-weight: 600;
                font-family: inherit;
                cursor: pointer;
                border-radius: var(--radius);
                transition: all 0.2s ease;
                display: inline-flex;
                align-items: center;
                gap: 12px;
            }
            button:hover:not(:disabled) {
                background: var(--chocolate-2);
                transform: translateY(-1px);
            }
            button:disabled {
                background: #d8d2c8;
                color: #a8a098;
                cursor: not-allowed;
            }
            button .arrow {
                font-family: "Cormorant Garamond", serif;
                font-size: 18px;
                line-height: 1;
            }

            #status {
                text-align: right;
                font-size: 13px;
                font-weight: 500;
                min-height: 20px;
                color: var(--text-muted);
            }

            /* Loading overlay clean */
            #loadingOverlay {
                position: fixed;
                inset: 0;
                background: rgba(247, 245, 241, 0.92);
                backdrop-filter: blur(6px);
                -webkit-backdrop-filter: blur(6px);
                display: flex;
                flex-direction: column;
                justify-content: center;
                align-items: center;
                z-index: 100;
            }
            .spinner {
                border: 2px solid var(--line);
                border-top: 2px solid var(--chocolate);
                border-radius: 50%;
                width: 32px;
                height: 32px;
                animation: spin 0.9s linear infinite;
                margin-bottom: 18px;
            }
            @keyframes spin {
                0% { transform: rotate(0deg); }
                100% { transform: rotate(360deg); }
            }
            .loading-text {
                font-size: 11px;
                letter-spacing: 0.25em;
                text-transform: uppercase;
                color: var(--text-muted);
                font-weight: 600;
            }

            /* Top navbar hamburger (mobile only) */
            .top-nav {
                display: none;
                align-items: center;
                justify-content: space-between;
                padding: 12px 20px;
                background: var(--surface);
                border-bottom: 1px solid var(--line);
                position: sticky;
                top: 0;
                z-index: 50;
            }
            .top-nav-brand {
                font-family: "Cormorant Garamond", serif;
                font-size: 1.1rem;
                font-weight: 600;
                color: var(--chocolate);
                letter-spacing: 0.04em;
            }
            .hamburger {
                width: 40px;
                height: 40px;
                background: transparent;
                border: 1px solid var(--line);
                border-radius: var(--radius);
                color: var(--chocolate);
                display: inline-flex;
                align-items: center;
                justify-content: center;
                cursor: pointer;
                padding: 0;
                transition: all 0.15s ease;
            }
            .hamburger:hover {
                border-color: var(--chocolate);
                background: var(--bg);
            }
            .hamburger svg { width: 20px; height: 20px; }
            .nav-drawer {
                position: fixed;
                top: 0;
                right: 0;
                height: 100vh;
                width: 260px;
                max-width: 80vw;
                background: var(--chocolate);
                color: var(--cream);
                padding: 24px 0;
                z-index: 90;
                transform: translateX(100%);
                transition: transform 0.25s ease;
                box-shadow: -8px 0 24px rgba(0,0,0,0.18);
            }
            .nav-drawer.open { transform: translateX(0); }
            .nav-drawer .nav-item {
                padding: 16px 24px;
                border-left: none;
                border-radius: 0;
                font-size: 14px;
                white-space: nowrap;
                color: rgba(245, 235, 214, 0.75);
            }
            .nav-drawer .nav-item:hover {
                background: rgba(212, 168, 87, 0.08);
                color: var(--cream);
            }
            .nav-drawer .nav-item.active {
                color: var(--gold);
                background: rgba(212, 168, 87, 0.12);
            }
            .nav-backdrop {
                position: fixed;
                inset: 0;
                background: rgba(42, 27, 21, 0.45);
                backdrop-filter: blur(2px);
                -webkit-backdrop-filter: blur(2px);
                z-index: 89;
                opacity: 0;
                pointer-events: none;
                transition: opacity 0.2s ease;
            }
            .nav-backdrop.open {
                opacity: 1;
                pointer-events: auto;
            }

            
            /* Responsive - sidebar collapse di mobile */
            
            /* Responsive - sidebar collapse di mobile */
            @media (max-width: 900px) {
                .layout { grid-template-columns: 1fr; }
                .sidebar { display: none; }
                .top-nav { display: flex; }
                .main { padding: 20px 16px; }
                .page-head { padding-bottom: 8px; margin-bottom: 14px; border-bottom: none; align-items: center; }
                .page-title { font-size: 1.15rem; line-height: 1.2; }
                .form-grid { grid-template-columns: 1fr; gap: 18px; }
                .radio-group { grid-template-columns: repeat(4, 1fr); }
                .card { padding: 24px 18px; }
                .card-head { margin-bottom: 20px; }
                .card-title { font-size: 1.2rem; }
                .card-tag { font-size: 9px; padding: 5px 10px; }
                .form-actions { flex-direction: column; gap: 12px; align-items: stretch; }
                .form-actions button {
                    width: 100%;
                    order: 1;
                    text-align: center;
                    justify-content: center;
                    padding: 16px;
                    font-size: 14px;
                }
                #status { order: 2; text-align: center; font-size: 11px; }
            }
             {
                .radio-group { grid-template-columns: repeat(2, 1fr); }
                .sidebar { padding: 12px 16px; }
                .sidebar-brand { font-size: 1.25rem; }
            } {
                .radio-group { grid-template-columns: repeat(2, 1fr); }
                .sidebar { padding: 12px 16px; }
                .sidebar-brand { font-size: 1.25rem; }
            }
</style>
    </head>
    <body>
                <nav class="top-nav">
            <div class="top-nav-brand">TELBA</div>
            <div style="display: flex; align-items: center; gap: 12px;">
                <div id="cartHeaderBtn" style="display:none; align-items:center; cursor:pointer; gap:4px; color:var(--chocolate);" onclick="toggleCartDrawer(true)">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
                    <span id="cartHeaderBadge" style="background:var(--chocolate); color:var(--cream); border-radius:50%; width:18px; height:18px; display:flex; align-items:center; justify-content:center; font-size:10px; font-weight:700;">0</span>
                </div>
                <button class="hamburger" id="hamburgerBtn" aria-label="Menu">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
                </button>
            </div>
        </nav>
        
        <div class="layout">
            <aside class="sidebar">
                <div class="sidebar-brand"><span class="dot"></span>TELBA</div>
                <div class="sidebar-sub">Internal Management</div>
                <nav class="sidebar-nav">
                    <div class="nav-item active">Sales Input</div>
                    <div class="nav-item">Analytics</div>
                    <div class="nav-item">Database</div>
                </nav>
            </aside>
            <main class="main">
                <header class="page-head">
                    <div>
                        <h1 class="page-title">Sales Input</h1>
                    </div>
                    <!-- Meta info removed -->
                </header>
                <div class="card">
                    <div class="card-head">
                        <h2 class="card-title">Entry Details</h2>
                        <span class="card-tag">New Record</span>
                    </div>

                    <form id="formPenjualan">
                        <div class="form-grid">
                            <div class="form-field">
                                <label for="tanggal">Tanggal</label>
                                <input type="date" id="tanggal" name="tanggal" required />
                            </div>
                            <div class="form-field">
                                <label for="sumber">Sumber</label>
                                <input type="text" id="sumber" name="sumber" value="Lapak 1" required />
                            </div>

                            <div class="form-field">
                                <label for="brand">Brand</label>
                                <input type="text" id="brand" name="brand" list="brandList" placeholder="Search brand..." autocomplete="off" disabled required />
                                <datalist id="brandList"></datalist>
                            </div>
                            <div class="form-field">
                                <label for="varian">Varian</label>
                                <input type="text" id="varian" name="varian" list="varianList" placeholder="Search variant..." autocomplete="off" disabled required />
                                <datalist id="varianList"></datalist>
                            </div>

                            <div class="form-field full">
                                <label>Volume (ml)</label>
                                <div class="radio-group" id="volumePreset">
                                    <label class="radio-item">
                                        <input type="radio" name="volumePreset" value="2" /> 2ml
                                    </label>
                                    <label class="radio-item">
                                        <input type="radio" name="volumePreset" value="3" /> 3ml
                                    </label>
                                    <label class="radio-item checked">
                                        <input type="radio" name="volumePreset" value="5" checked /> 5ml
                                    </label>
                                    <label class="radio-item">
                                        <input type="radio" name="volumePreset" value="10" /> 10ml
                                    </label>
                                </div>
                                <input type="text" id="volumeCustom" name="volumeCustom" placeholder="Volume custom (angka saja)..." autocomplete="off" style="margin-top: 12px;" />
                            </div>

                            <div class="form-field">
                                <label for="harga">Harga Jual</label>
                                <div class="input-prefix">
                                    <input type="text" inputmode="numeric" id="harga" name="harga" placeholder="0" disabled required />
                                </div>
                            </div>
                            <div class="form-field">
                                <label>Pembayaran</label>
                                <div class="radio-group" id="ketGroup" style="grid-template-columns: 1fr 1fr;">
                                    <label class="radio-item">
                                        <input type="radio" name="ket" value="Cash" /> Cash
                                    </label>
                                    <label class="radio-item">
                                        <input type="radio" name="ket" value="Qris" /> QRIS
                                    </label>
                                </div>
                            </div>

                            <div class="form-field full">
                                <label for="keterangan">Keterangan <span style="text-transform:none;letter-spacing:0;font-weight:500;color:#9b8f80;">(Opsional)</span></label>
                                <textarea id="keterangan" name="keterangan" placeholder="Catatan tambahan..." rows="2"></textarea>
                            </div>
                        </div>

                        <div class="form-actions">
                            <button type="button" id="btnAddCart" style="background:var(--cream); color:var(--chocolate); border:1px solid var(--chocolate); padding:16px 20px; flex:1;">
                                + Tambah ke Keranjang
                            </button>
                            <button type="submit" id="btnSubmit" style="flex:1;">
                                Simpan Semua <span class="arrow">→</span>
                            </button>
                        </div>
                        
                        
                    </form>
                </div>
            </main>
        </div>
        
        <div class="nav-backdrop" id="navBackdrop"></div>
        <aside class="nav-drawer" id="navDrawer">
            <div class="nav-item active">Sales Input</div>
            <div class="nav-item">Analytics</div>
            <div class="nav-item">Database</div>
        </aside>

        <div id="loadingOverlay">
            <div class="spinner"></div>
            <div class="loading-text">Memuat Database...</div>
        </div>

        <script is:inline define:vars={{ GAS_API_URL }}>
            // Format Tanggal Lokal Perangkat
            const today = new Date();
            const yyyy = today.getFullYear();
            const mm = String(today.getMonth() + 1).padStart(2, "0");
            const dd = String(today.getDate()).padStart(2, "0");
            document.getElementById("tanggal").value = `${yyyy}-${mm}-${dd}`;

            const form = document.getElementById("formPenjualan");
            const inputBrand = document.getElementById("brand");
            const dataListBrand = document.getElementById("brandList");
            const inputVarian = document.getElementById("varian");
            const dataListVarian = document.getElementById("varianList");
            const volumeCustom = document.getElementById("volumeCustom");
            const volumeRadios = document.getElementsByName("volumePreset");
            const ketRadios = document.getElementsByName("ket");
            const inputHarga = document.getElementById("harga");
            const btnSubmit = document.getElementById("btnSubmit");
            const btnAddCart = document.getElementById("btnAddCart");
            const cartSection = document.getElementById("cartSection");
            const cartList = document.getElementById("cartList");
            const cartCount = document.getElementById("cartCount");
            let cart = [];

            // Add to cart logic
            btnAddCart.addEventListener("click", () => {
                const payload = getFormPayload(); // Perlu extract payload logic dulu
                cart.push(payload);
                renderCart();
            });

            function renderCart() {
                cartSection.style.display = cart.length ? "block" : "none";
                cartCount.innerText = cart.length;
                cartList.innerHTML = cart.map((item, idx) => `
                    <div style="display:flex; justify-content:space-between; margin-bottom:8px;">
                        <span>${item.brand} - ${item.varian} (${item.volume}ml)</span>
                        <span style="color:var(--gold); cursor:pointer;" onclick="removeFromCart(${idx})">×</span>
                    </div>
                `).join("");
            }

            function removeFromCart(idx) {
                cart.splice(idx, 1);
                renderCart();
            }

            function getFormPayload() {
                const hargaAngka = parseInt(inputHarga.value.replace(/\./g, ""), 10);
                const hargaSimpan = isNaN(hargaAngka) ? "" : HARGA_DALAM_RIBUAN ? Math.round(hargaAngka / 1000) : hargaAngka;
                const ketEl = [...ketRadios].find((r) => r.checked);
                return {
                    tanggal: document.getElementById("tanggal").value,
                    brand: inputBrand.value,
                    varian: inputVarian.value,
                    volume: getVolumeValue(),
                    harga: String(hargaSimpan),
                    ket: ketEl ? ketEl.value : "",
                    sumber: document.getElementById("sumber").value,
                    keterangan: document.getElementById("keterangan").value,
                };
            }

            const overlay = document.getElementById("loadingOverlay");
            const priceIcon = document.getElementById("priceIcon");
            const statusDiv = document.getElementById("status");
            const hamburgerBtn = document.getElementById("hamburgerBtn");
            const navDrawer = document.getElementById("navDrawer");
            const navBackdrop = document.getElementById("navBackdrop");

            // Drawer toggle
            function toggleNav(open) {
                const willOpen = open ?? !navDrawer.classList.contains("open");
                navDrawer.classList.toggle("open", willOpen);
                navBackdrop.classList.toggle("open", willOpen);
            }
            hamburgerBtn.addEventListener("click", () => toggleNav());
            navBackdrop.addEventListener("click", () => toggleNav(false));
            // Tutup drawer kalau nav-item diklik
            document.querySelectorAll(".nav-drawer .nav-item").forEach((item) => {
                item.addEventListener("click", () => toggleNav(false));
            });

            let databaseProduk = {};
            let hargaPatokan = null;

            // Konvensi harga di sheet:
            //   true  -> nilai disimpan DALAM RIBUAN (30 = Rp 30.000)
            //   false -> nilai disimpan NILAI ASLI rupiah (30000 = Rp 30.000)
            const HARGA_DALAM_RIBUAN = true;

            function keRupiahPenuh(n) {
                return HARGA_DALAM_RIBUAN ? n * 1000 : n;
            }

            function formatRupiah(n) {
                return Number(n).toLocaleString("id-ID");
            }

            const iconCheck = `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>`;
            const iconEdit = `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>`;

            function updateIconHarga() {
                if (!priceIcon) return;
                const angkaInput = parseInt(
                    inputHarga.value.replace(/\./g, ""),
                    10,
                );
                if (
                    hargaPatokan === null ||
                    isNaN(angkaInput) ||
                    inputHarga.value.trim() === ""
                ) {
                    priceIcon.style.display = "none";
                } else if (angkaInput === parseInt(hargaPatokan, 10)) {
                    priceIcon.innerHTML = iconCheck;
                    priceIcon.style.display = "flex";
                } else {
                    priceIcon.innerHTML = iconEdit;
                    priceIcon.style.display = "flex";
                }
            }

            // Ambil nilai volume aktif: custom text kalau diisi, else radio preset.
            function getVolumeValue() {
                const custom = volumeCustom.value.trim();
                if (custom) return custom;
                const checked = [...volumeRadios].find((r) => r.checked);
                return checked ? checked.value : "";
            }

            function kalkulasiHarga() {
                const brand = inputBrand.value.trim();
                const varian = inputVarian.value.trim();
                const vol = getVolumeValue();

                if (databaseProduk[brand] && databaseProduk[brand][varian]) {
                    const hargaObj = databaseProduk[brand][varian];
                    const mentah =
                        (vol === "5" || vol === "10") &&
                        hargaObj[vol] !== undefined
                            ? hargaObj[vol]
                            : null;
                    hargaPatokan = mentah !== null ? keRupiahPenuh(mentah) : null;
                    if (hargaPatokan !== null) {
                        inputHarga.value = formatRupiah(hargaPatokan);
                    } else {
                        inputHarga.value = "";
                    }
                } else {
                    hargaPatokan = null;
                }
                updateIconHarga();
            }

            inputBrand.addEventListener("input", function () {
                const brandDipilih = this.value.trim();
                console.log("Input Brand:", brandDipilih);
                
                dataListVarian.innerHTML = "";
                inputVarian.value = "";
                inputHarga.value = "";
                hargaPatokan = null;
                updateIconHarga();

                // Coba cari keys yang mirip atau case-insensitive jika perlu
                if (databaseProduk[brandDipilih]) {
                    console.log("Brand ditemukan, memuat varian...");
                    Object.keys(databaseProduk[brandDipilih]).forEach((varian) => {
                        let option = document.createElement("option");
                        option.value = varian;
                        dataListVarian.appendChild(option);
                        console.log("Varian ditambahkan:", varian);
                    });
                } else {
                    console.warn("Brand tidak ditemukan dalam database! Database keys:", Object.keys(databaseProduk));
                }
            });

            inputVarian.addEventListener("input", kalkulasiHarga);

            // Sync volume: radio preset <-> custom text
            function syncVolumeUI() {
                volumeRadios.forEach((r) => {
                    const item = r.closest(".radio-item");
                    if (item) item.classList.toggle("checked", r.checked);
                });
                const custom = volumeCustom.value.trim();
                if (custom) {
                    volumeRadios.forEach((r) => (r.checked = false));
                } else if (![...volumeRadios].some((r) => r.checked)) {
                    volumeRadios[0].checked = true;
                    const item = volumeRadios[0].closest(".radio-item");
                    if (item) item.classList.add("checked");
                }
                kalkulasiHarga();
            }
            volumeRadios.forEach((r) =>
                r.addEventListener("change", syncVolumeUI),
            );
            volumeCustom.addEventListener("input", syncVolumeUI);

            inputHarga.addEventListener("input", updateIconHarga);

            // Pembayaran: highlight selected
            ketRadios.forEach((r) =>
                r.addEventListener("change", () => {
                    ketRadios.forEach((x) =>
                        x.closest(".radio-item").classList.toggle(
                            "checked",
                            x.checked,
                        ),
                    );
                }),
            );

            form.addEventListener("submit", async function (e) {
                e.preventDefault();
                if (cart.length === 0) {
                    // Kalau kosong, submit data saat ini saja
                    cart.push(getFormPayload());
                }

                btnSubmit.disabled = true;
                btnSubmit.innerText = "⏳ Menyimpan " + cart.length + " data...";
                    
                try {
                    for (const payload of cart) {
                         const res = console.log('Sending:', payload);
                        await fetch(GAS_API_URL, {
                            method: "POST",
                            headers: { "Content-Type": "text/plain;charset=utf-8" },
                            body: JSON.stringify(payload),
                        });
                        if (!res.ok) throw new Error("Gagal kirim: " + payload.varian);
                    }
                    statusDiv.innerText = "✅ Semua data tersimpan!";
                    cart = [];
                    renderCart();
                    // Reset form
                    inputBrand.value = ""; inputVarian.value = ""; inputHarga.value = ""; 
                } catch (err) {
                    statusDiv.innerText = "❌ Gagal: " + err.message;
                } finally {
                    btnSubmit.disabled = false;
                    btnSubmit.innerText = "Simpan Semua";
                }
            });

            
            const cartHeaderBtn = document.getElementById("cartHeaderBtn");
            const cartHeaderBadge = document.getElementById("cartHeaderBadge");
            const cartDrawerList = document.getElementById("cartDrawerList");
            const btncartSubmit = document.getElementById("btnCartSubmit");
            let cart = [];

            window.toggleCartDrawer = function(open) {
                const drawer = document.getElementById("cartDrawer");
                drawer.classList.toggle("open", open);
                navBackdrop.classList.toggle("open", open);
            };

            function renderCart() {
                const has = cart.length > 0;
                cartHeaderBtn.style.display = has ? "flex" : "none";
                cartHeaderBadge.innerText = cart.length;

                cartDrawerList.innerHTML = cart.map((item, idx) => `
                    <div style="background:rgba(255,255,255,0.05); padding:12px; border-radius:var(--radius); display:flex; justify-content:space-between; align-items:center;">
                        <div>
                            <div style="font-weight:600; color:var(--gold);">${item.brand}</div>
                            <div style="font-size:12px; color:rgba(255,255,255,0.7);">${item.varian} (${item.volume}ml)</div>
                        </div>
                        <button type="button" onclick="removeFromCart(${idx})" style="background:none; border:none; color:#ff4d4d; cursor:pointer; font-size:1.2rem;">&times;</button>
                    </div>
                `).join("");
            }

            window.removeFromCart = function(idx) {
                cart.splice(idx, 1);
                renderCart();
                if (cart.length === 0) toggleCartDrawer(false);
            };

            btnAddCart.addEventListener("click", () => {
                const payload = getFormPayload();
                if (!payload.brand || !payload.varian) {
                    alert("Pilih brand dan varian dulu bro!");
                    return;
                }
                cart.push(payload);
                renderCart();
                // Clear fields
                inputBrand.value = ""; inputVarian.value = ""; inputHarga.value = ""; volumeCustom.value = "";
                document.getElementById("keterangan").value = "";
                statusDiv.innerText = "✅ Masuk keranjang";
                setTimeout(() => statusDiv.innerText = "Ready", 1500);
            });

            btncartSubmit.addEventListener("click", async () => {
                if (cart.length === 0) return;
                btncartSubmit.disabled = true;
                btncartSubmit.innerText = "⏳ MENYIMPAN " + cart.length + " DATA...";

                try {
                    for (const payload of cart) {
                        console.log('Sending:', payload);
                        await fetch(GAS_API_URL, {
                            method: "POST",
                            headers: { "Content-Type": "text/plain;charset=utf-8" },
                            body: JSON.stringify(payload),
                        });
                    }
                    alert("✅ Semua data berhasil disimpan ke Google Sheets!");
                    cart = [];
                    renderCart();
                    toggleCartDrawer(false);
                } catch (e) {
                    alert("❌ Gagal: " + e.message);
                } finally {
                    btncartSubmit.disabled = false;
                    btncartSubmit.innerText = "SIMPAN SEMUA DATA";
                }
            });

            async function initApp() {
                try {
                    const dbUrls = [
                        GAS_API_URL + "?action=getDatabase",
                        GAS_API_URL,
                    ];
                    for (const url of dbUrls) {
                        try {
                            const res = await fetch(url, {
                                method: "GET",
                                cache: "no-store",
                            });
                            if (!res.ok) continue;
                            let data = await res.json();
                            let db = null;
                            if (
                                data &&
                                data.status === "success" &&
                                data.data
                            ) {
                                db = data.data;
                            } else if (data && typeof data === "object") {
                                db = data;
                            }
                            if (
                                db &&
                                typeof db === "object" &&
                                Object.keys(db).length > 0
                            ) {
                                databaseProduk = db;
                                console.log("Database dimuat. Brand list:", Object.keys(databaseProduk));
                                Object.keys(databaseProduk).forEach((brand) => {
                                    const opt =
                                        document.createElement("option");
                                    opt.value = brand;
                                    dataListBrand.appendChild(opt);
                                });
                                statusDiv.innerText =
                                    "✅ Database produk dimuat (" +
                                    Object.keys(databaseProduk).length +
                                    " brand)";
                                statusDiv.style.color = "#16a34a";
                                break;
                            }
                        } catch (err) {
                            // CORS / network error -> coba URL berikutnya
                        }
                    }
                } finally {
                    overlay.style.display = "none";
                    inputBrand.disabled = false;
                    inputVarian.disabled = false;
                    inputHarga.disabled = false;
                    btnSubmit.disabled = false;
                }
            }

            initApp();
        </script>
    </body>
</html>
